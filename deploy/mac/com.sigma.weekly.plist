<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces __SIGMA_REPO__ and writes ~/Library/LaunchAgents/com.sigma.weekly.plist.
     Sundays 14:30 local (fetch and transcribe for the weekly digest). A run missed while asleep fires once on the next wake (launchd catch-up). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sigma.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SIGMA_REPO__/deploy/mac/run-weekly.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__SIGMA_REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SIGMA_DATA_ROOT</key><string>__SIGMA_DATA_ROOT__</string>
    <key>SIGMA_WHISPER_BACKEND</key><string>mlx</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__SIGMA_REPO__/logs/launchd-weekly.out.log</string>
  <key>StandardErrorPath</key><string>__SIGMA_REPO__/logs/launchd-weekly.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
