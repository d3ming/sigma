{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selected.json: must-watch picks for one daily run: every episode scored 6+, never fewer than 3 a day (fill with the best 5s, flagged lower_confidence)",
  "type": "object",
  "required": ["date", "run_dir", "selected_by", "episodes"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "run_dir": {"type": "string"},
    "selected_by": {"type": "string"},
    "episodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["episode_id", "title", "show", "url", "guests", "kind", "why"],
        "additionalProperties": false,
        "properties": {
          "episode_id": {"type": "string"},
          "title": {"type": "string"},
          "show": {"type": "string"},
          "url": {"type": "string"},
          "youtube_url": {"type": "string", "pattern": "^https://(www\\.)?(youtube\\.com/watch\\?v=|youtu\\.be/)", "description": "verified YouTube video of this episode; omit rather than guess"},
          "youtube_published": {"type": "string", "description": "YouTube upload date (YYYY-MM-DD) seen in search results"},
          "listen_url": {"type": "string", "description": "YouTube/Spotify/Apple episode page or feed episode page; never audio/tracking"},
          "guests": {"type": "array", "items": {"type": "object", "required": ["name"], "additionalProperties": false,
                     "properties": {"name": {"type": "string"}, "role": {"type": "string"}}}},
          "kind": {"enum": ["exec", "investor", "analyst", "other"]},
          "has_transcript": {"type": "boolean"},
          "fallback_text": {"type": "boolean", "description": "manifest fallback_text: only a show description, no real transcript"},
          "rerun": {"type": "boolean"},
          "lower_confidence": {"type": "boolean", "description": "true only for a score-5 pick added to reach the 3-a-day minimum; never for a 6+"},
          "why": {"type": "string", "maxLength": 300}
        }
      }
    },
    "left_out": {
      "type": "array",
      "description": "every episode scored 6+ that is not picked, and every 5+ left out of a day with under 3 picks, with the rule that rejected it",
      "items": {
        "type": "object", "required": ["episode_id", "reason"], "additionalProperties": false,
        "properties": {
          "episode_id": {"type": "string"},
          "reason": {"enum": ["news_show", "recap", "clip", "hosts_only", "speaker_other", "duplicate_person", "rerun",
                              "not_decision_relevant", "repeat_appearance"]},
          "note": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}
