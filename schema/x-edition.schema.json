{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signals X daily edition",
  "type": "object",
  "required": ["date", "signals", "posts"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "headline": {"type": "string", "maxLength": 120},
    "signals": {"$ref": "#/$defs/blurb"},
    "posts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {"id": {"type": "string", "pattern": "^\\d{5,25}$"}}
      }
    }
  },
  "$defs": {
    "blurb": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["text", "cites"],
        "additionalProperties": false,
        "properties": {
          "theme": {"type": "string", "minLength": 3, "maxLength": 60},
          "text": {"type": "string", "minLength": 20, "maxLength": 400},
          "cites": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"type": "string", "pattern": "^\\d{5,25}$"}
          }
        }
      }
    }
  }
}
