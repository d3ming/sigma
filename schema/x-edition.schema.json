{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X daily edition, written by the editor agent (prompts/x-daily.md) to <x dir>/days/<date>/edition.json",
  "type": "object",
  "required": ["date", "alpha", "posts"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "headline": {"type": "string", "maxLength": 120, "description": "the day in one line"},
    "alpha": {"$ref": "#/$defs/blurb"},
    "si": {"$ref": "#/$defs/blurb", "description": "what the AI and agent accounts saw or argued, cited to lens si posts; empty when they had nothing"},
    "posts": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "description": "the posts shown under the blurbs, best first; ids only",
      "items": {"type": "object", "required": ["id", "lens"], "additionalProperties": false,
                "properties": {"id": {"type": "string", "pattern": "^\\d{5,25}$"}, "lens": {"enum": ["alpha", "si"]}}}
    }
  },
  "$defs": {
    "blurb": {
      "type": "array", "maxItems": 14,
      "items": {"type": "object", "required": ["text", "cites"], "additionalProperties": false,
                "properties": {"theme": {"type": "string", "minLength": 3, "maxLength": 60,
                                         "description": "the section this sentence belongs to; a theme's sentences are consecutive"},
                               "text": {"type": "string", "minLength": 20, "maxLength": 400},
                               "cites": {"type": "array", "minItems": 1, "maxItems": 3,
                                         "items": {"type": "string", "pattern": "^\\d{5,25}$"}}}}
    }
  }
}
