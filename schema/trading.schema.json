{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "playlists",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "playlists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PL[A-Za-z0-9_-]{10,70}$"
          },
          "title": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "digest",
          "clips",
          "videos"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "digest": {
            "$ref": "#/$defs/text"
          },
          "videos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "duration"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/videoId"
                },
                "title": {
                  "$ref": "#/$defs/text"
                },
                "duration": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "clips": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "video",
                "seconds",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "video": {
                  "$ref": "#/$defs/videoId"
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "videoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    }
  }
}
