{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "episodes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/episode"
      }
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "reference_url": {
      "type": "string",
      "pattern": "^https?://[^\\s\\x00-\\x1f\\x7f<>\"\\\\]+$"
    },
    "reference_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": {"type": "string", "pattern": "\\S"},
        "url": {"$ref": "#/$defs/reference_url"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "context", "relationship"],
      "properties": {
        "title": {"type": "string", "pattern": "\\S"},
        "url": {"$ref": "#/$defs/reference_url"},
        "context": {"type": "string", "pattern": "\\S"},
        "relationship": {"enum": ["discussed", "related", "inferred"]},
        "source": {"type": "string", "pattern": "\\S"},
        "start": {"type": "integer", "minimum": 0},
        "supporting_urls": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference_link"}
        }
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "text",
        "why_it_matters",
        "speaker",
        "start",
        "end",
        "companies",
        "inference"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string"
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "companies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "text",
        "start",
        "end"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "source_sha256",
        "key_insights",
        "dense_summary"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "key_insights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/insight"
          }
        },
        "dense_summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "references": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        },
        "topics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
