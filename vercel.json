{
  "buildCommand": "python3 -m sigma.site --out dist",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/alpha/:path*",
      "destination": "/signals/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/show-art/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
